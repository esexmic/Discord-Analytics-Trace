# XYB — variables de entorno (todas opcionales)
#
# El panel funciona sin .env: al abrirlo por primera vez te pide crear la
# cuenta (usuario + contraseña + key de acceso) y después pegás el token de
# Discord y las claves de Supabase en Ajustes. Las cuentas, el HWID y los
# eventos viven en Supabase; el resto se guarda en data/settings.json.
#
# Lo que definas acá GANA sobre lo que haya en el panel y queda bloqueado en la
# interfaz. En un deploy (Railway, VPS) usá env: el disco puede ser efímero.

# Token de la cuenta de Discord que hace el scraping.
# DevTools > Application > Local Storage > https://discord.com -> token
# Usá una cuenta secundaria: esto es una selfbot y va contra los ToS.
DISCORD_TOKEN=

# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...service_role...

# Key que se pide para crear cuentas desde el panel. Repartila solo con quien
# deba tener acceso. Si queda vacía, el server genera una y la imprime en el
# log del arranque; un admin puede verla en Ajustes > Cuenta > Ver key.
# En Railway definila para que sobreviva a los redeploys.
ACCESS_KEY=
# REGISTRATION_KEY=   # alias de ACCESS_KEY

# Cuenta legacy del deploy (opcional). Entra sin HWID y se migra sola a la
# tabla accounts. La contraseña se cambia acá, no desde el panel.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Secreto para firmar la cookie de sesión. Si falta, se genera y se guarda en
# data/settings.json. Cambiarlo cierra todas las sesiones abiertas.
SESSION_SECRET=

# Puerto (Railway lo inyecta solo)
PORT=3000

# true = loguear TODOS los usuarios de los servidores, no solo los targets
TRACK_ALL=false

# IDs extra de targets separados por coma (se suman a los de la DB)
TARGETS=

# Estado con el que se muestra la propia cuenta: online | idle | dnd | invisible
# (vacío = no tocar nada)
SELF_PRESENCE=

# Webhook opcional para alertas de conexión/voz/stream
# (https://discord.com/api/webhooks/...)
ALERT_WEBHOOK=

# Carpeta donde se guarda settings.json (por defecto ./data)
DATA_DIR=
