# XYB — variables de entorno (todas opcionales)
#
# El server se configura SOLO acá. El panel no pide Supabase ni keys: cada
# persona que entra crea su cuenta, pega su token de Discord y fija objetivos.
# Cuentas, tokens, objetivos y eventos viven en la tabla correspondiente de
# Supabase (corré schema.sql). En data/ solo queda el secreto de sesión generado.
#
# Sin SUPABASE_URL / SUPABASE_SERVICE_KEY el panel funciona en modo demo local:
# se puede entrar y navegar, pero no se guardan objetivos ni eventos.

# Supabase (Project Settings > API). La service_role bypassea RLS: va solo acá,
# nunca en el frontend ni en un repo público. La publishable/anon NO sirve.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...service_role...

# Cuenta legacy del deploy (opcional). Entra sin HWID y se migra sola a la
# tabla accounts en el primer login. Su contraseña se cambia acá, no desde el
# panel. Si no la definís, el primer registro queda como admin.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Secreto para firmar la cookie de sesión. Si falta, se genera y se guarda en
# data/settings.json. Cambiarlo cierra todas las sesiones abiertas.
SESSION_SECRET=

# Puerto (Railway lo inyecta solo)
PORT=3000

# true = loguear TODOS los usuarios de los servidores, no solo los targets
TRACK_ALL=false

# IDs extra de targets separados por coma (se suman a los de todas las cuentas)
TARGETS=

# Estado con el que se muestra la propia cuenta: online | idle | dnd | invisible
# (vacío = no tocar nada)
SELF_PRESENCE=

# Webhook opcional para alertas de conexión/voz/stream
# (https://discord.com/api/webhooks/...)
ALERT_WEBHOOK=

# Carpeta donde se guarda settings.json (por defecto ./data)
DATA_DIR=
